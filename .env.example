# RumorRemover backend configuration
# Copy this file to ".env" and fill in your values. The .env file is gitignored.

# Required: API key for your OpenAI-compatible endpoint
AI_KEY=

# Required: model id served by your endpoint
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional: defaults to the Nebius Token Factory endpoint
BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1

# Optional: port to serve on
PORT=4321
