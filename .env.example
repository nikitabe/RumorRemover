# RumorRemover backend configuration
# Copy this file to ".env" and fill in your values. The .env file is gitignored.
#
# The backend auto-detects the provider from BASE_URL:
#   - an Anthropic URL (api.anthropic.com)  -> Messages API (x-api-key auth)
#   - any other OpenAI-compatible URL        -> Chat Completions API (Bearer auth)

# Required: API key for your chosen provider
AI_KEY=

# Required: model id
#   Anthropic example: claude-sonnet-4-6
#   Nebius example:    moonshotai/Kimi-K2.6
LLM_MODEL=claude-sonnet-4-6

# Optional: API base URL
#   Anthropic: https://api.anthropic.com/v1
#   Nebius:    https://api.tokenfactory.us-central1.nebius.com/v1
BASE_URL=https://api.anthropic.com/v1

# Optional: port to serve on (local server only)
PORT=4321
