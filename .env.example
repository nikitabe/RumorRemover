# RumorRemover backend configuration
# Copy this file to ".env" and fill in your values. The .env file is gitignored.

# Required: Anthropic API key (sent as the x-api-key header)
AI_KEY=

# Required: model id
LLM_MODEL=claude-sonnet-4-6

# Optional: defaults to the Anthropic API base
BASE_URL=https://api.anthropic.com/v1

# Optional: port to serve on
PORT=4321
